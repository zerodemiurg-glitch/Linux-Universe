#!/bin/bash
# Linux-Universe Air-Gap Mode toggle (defense-in-depth, not hardware-level isolation)

STATE_FILE="/var/lib/linux-universe/airgap-state"
mkdir -p /var/lib/linux-universe
LOGGER_TAG="linux-universe-airgap"

if [ "$1" = "on" ]; then
    logger -t "$LOGGER_TAG" "Air-Gap ENABLED by uid=$(id -u) at $(date)"
    nmcli networking off
    rfkill block all
    iptables -P INPUT DROP
    iptables -P OUTPUT DROP
    iptables -P FORWARD DROP
    for mod in iwlwifi ath9k r8169 e1000e; do
        modprobe -r "$mod" 2>/dev/null || true
    done
    echo "on" > "$STATE_FILE"
    notify-send "Linux-Universe" "Air-Gap Mode ENABLED (multi-layer: interfaces + firewall + drivers unloaded)" -i network-offline 2>/dev/null
    echo "Air-Gap Mode: ON"
elif [ "$1" = "off" ]; then
    logger -t "$LOGGER_TAG" "Air-Gap DISABLED by uid=$(id -u) at $(date)"
    iptables -P INPUT ACCEPT
    iptables -P OUTPUT ACCEPT
    iptables -P FORWARD ACCEPT
    nmcli networking on
    rfkill unblock all
    echo "off" > "$STATE_FILE"
    notify-send "Linux-Universe" "Air-Gap Mode DISABLED" -i network-idle 2>/dev/null
    echo "Air-Gap Mode: OFF"
elif [ "$1" = "status" ]; then
    [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "off"
else
    echo "Usage: linux-universe-airgap [on|off|status]"
    exit 1
fi
