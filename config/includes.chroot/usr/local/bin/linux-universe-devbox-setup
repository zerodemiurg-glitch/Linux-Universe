#!/bin/bash
# Linux-Universe Dev-Box Workspace: first-run language setup (offline, prebuilt images)

MARKER="$HOME/.config/linux-universe/devbox-setup-done"

if [ -f "$MARKER" ]; then
    exit 0
fi

LANG_CHOICE=$(zenity --list --title="Linux-Universe Dev-Box Workspace" \
    --text="На каком языке/стеке ты программируешь?\nМожно выбрать несколько.\n(Уже встроено в систему, интернет не нужен)" \
    --checklist --column="Выбрать" --column="Язык" \
    FALSE "Python" \
    FALSE "Node.js / JavaScript" \
    FALSE "Go" \
    FALSE "Rust" \
    FALSE "Java / Kotlin" \
    FALSE "C / C++" \
    --separator=":" --width=420 --height=350)

if [ -z "$LANG_CHOICE" ]; then
    mkdir -p "$(dirname "$MARKER")"
    touch "$MARKER"
    exit 0
fi

IMG_DIR="/usr/share/linux-universe/devbox-images"

(
echo "5"; echo "# Разворачиваю Dev-Box окружения (офлайн)..."

IFS=":" read -ra LANGS <<< "$LANG_CHOICE"
TOTAL=${#LANGS[@]}
COUNT=0

for LANG in "${LANGS[@]}"; do
    COUNT=$((COUNT+1))
    PCT=$((5 + COUNT * 90 / TOTAL))
    echo "$PCT"; echo "# Загружаю окружение: $LANG"

    case "$LANG" in
        "Python")             KEY="python"; NAME="dev-python" ;;
        "Node.js / JavaScript") KEY="node";   NAME="dev-node" ;;
        "Go")                 KEY="go";     NAME="dev-go" ;;
        "Rust")                KEY="rust";   NAME="dev-rust" ;;
        "Java / Kotlin")       KEY="java";   NAME="dev-java" ;;
        "C / C++")             KEY="cpp";    NAME="dev-cpp" ;;
        *) continue ;;
    esac

    if [ -f "$IMG_DIR/$KEY.tar" ]; then
        podman load -i "$IMG_DIR/$KEY.tar"
        distrobox create --name "$NAME" --image "local/dev-$KEY" --yes
    fi
done

echo "100"; echo "# Готово!"
) | zenity --progress --title="Linux-Universe Dev-Box Workspace" --text="Настройка..." --percentage=0 --auto-close --width=420

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"

zenity --info --title="Linux-Universe" --text="Dev-Box Workspace готов!\nОкружения загружены без интернета.\nОткрывай: distrobox enter <имя>" --width=350
