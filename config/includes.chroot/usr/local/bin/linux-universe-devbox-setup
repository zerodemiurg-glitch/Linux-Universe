#!/bin/bash
# Linux-Universe Dev-Box Workspace: first-run language setup (minimal footprint)

MARKER="$HOME/.config/linux-universe/devbox-setup-done"

if [ -f "$MARKER" ]; then
    exit 0
fi

LANG_CHOICE=$(zenity --list --title="Linux-Universe Dev-Box Workspace" \
    --text="На каком языке/стеке ты программируешь?\nМожно выбрать несколько.\n(Минимальные окружения, без лишнего)" \
    --checklist --column="Выбрать" --column="Язык" \
    FALSE "Python" \
    FALSE "Node.js / JavaScript" \
    FALSE "Go" \
    FALSE "Rust" \
    FALSE "Java / Kotlin" \
    FALSE "C / C++" \
    --separator=":" --width=420 --height=350)

if [ -z "$LANG_CHOICE" ]; then
    mkdir -p "$(dirname "$MARKER")"
    touch "$MARKER"
    exit 0
fi

(
echo "5"; echo "# Настройка Dev-Box окружений (минимальные)..."

IFS=":" read -ra LANGS <<< "$LANG_CHOICE"
TOTAL=${#LANGS[@]}
COUNT=0

for LANG in "${LANGS[@]}"; do
    COUNT=$((COUNT+1))
    PCT=$((5 + COUNT * 90 / TOTAL))
    echo "$PCT"; echo "# Разворачиваю минимальное окружение: $LANG"

    case "$LANG" in
        "Python")
            NAME="dev-python"; PKGS="python3 python3-pip python3-venv"
            ;;
        "Node.js / JavaScript")
            NAME="dev-node"; PKGS="nodejs npm"
            ;;
        "Go")
            NAME="dev-go"; PKGS="golang-go"
            ;;
        "Rust")
            NAME="dev-rust"; PKGS="rustc cargo"
            ;;
        "Java / Kotlin")
            NAME="dev-java"; PKGS="default-jdk"
            ;;
        "C / C++")
            NAME="dev-cpp"; PKGS="build-essential gdb"
            ;;
        *)
            continue
            ;;
    esac

    distrobox create --name "$NAME" --image debian:stable-slim --yes
    distrobox enter "$NAME" -- sudo apt-get update
    distrobox enter "$NAME" -- sudo apt-get install -y --no-install-recommends $PKGS
done

echo "100"; echo "# Готово!"
) | zenity --progress --title="Linux-Universe Dev-Box Workspace" --text="Настройка..." --percentage=0 --auto-close --width=420

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"

zenity --info --title="Linux-Universe" --text="Dev-Box Workspace готов!\nЛёгкие окружения без лишнего мусора — только то, что реально нужно.\nОткрывай: distrobox enter <имя>" --width=350
