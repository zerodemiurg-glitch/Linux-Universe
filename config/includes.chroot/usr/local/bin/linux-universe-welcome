#!/bin/bash

if grep -qE "boot=live|casper" /proc/cmdline 2>/dev/null || [ -d /run/live ]; then
    exit 0
fi

MARKER="$HOME/.config/linux-universe/welcome-shown"
mkdir -p "$(dirname "$MARKER")"

if [ ! -f "$MARKER" ]; then
    /usr/local/bin/linux-universe-welcome-server &
    SERVER_PID=$!

    epiphany --application-mode --profile="$HOME/.cache/lu-welcome-profile" "http://127.0.0.1:8743/" &
    EPIPH_PID=$!

    wait $SERVER_PID
    pkill -f "lu-welcome-profile" 2>/dev/null || true

    touch "$MARKER"
fi

/usr/local/bin/linux-universe-devbox-setup
