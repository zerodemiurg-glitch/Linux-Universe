#!/bin/bash
set -e

echo "Setting up Linux-Universe book library (Project Gutenberg, Russian language, public domain)..."

LIB_DIR="/usr/share/linux-universe/books"
mkdir -p "$LIB_DIR"

CATALOG_URL="https://www.gutenberg.org/cache/epub/feeds/pg_catalog.csv.gz"
curl -fsSL "$CATALOG_URL" -o /tmp/pg_catalog.csv.gz || { echo "WARNING: catalog download failed"; exit 0; }
gunzip -f /tmp/pg_catalog.csv.gz

python3 << 'PYEOF'
import csv, urllib.request, os

LIB_DIR = "/usr/share/linux-universe/books"
MAX_BYTES = 60 * 1024 * 1024
current_bytes = 0
count = 0

with open("/tmp/pg_catalog.csv", newline='', encoding='utf-8', errors='ignore') as f:
    reader = csv.DictReader(f)
    for row in reader:
        if row.get("Language") != "ru":
            continue
        book_id = row.get("Text#")
        if not book_id:
            continue
        url = f"https://www.gutenberg.org/ebooks/{book_id}.epub.noimages"
        out_path = os.path.join(LIB_DIR, f"{book_id}.epub")
        try:
            urllib.request.urlretrieve(url, out_path)
            size = os.path.getsize(out_path)
            if size > 0:
                current_bytes += size
                count += 1
            else:
                os.remove(out_path)
        except Exception:
            if os.path.exists(out_path):
                os.remove(out_path)
            continue
        if current_bytes >= MAX_BYTES:
            break

print(f"Downloaded {count} books, {current_bytes / (1024*1024):.1f} MB total")
PYEOF

echo "Book library setup complete"
