#!/bin/bash
set -e

echo "Setting up Linux-Universe book library (ru.wikisource.org, public domain / CC BY-SA)..."

LIB_DIR="/usr/share/linux-universe/books"
mkdir -p "$LIB_DIR"

python3 << 'PYEOF'
import urllib.request, urllib.parse, json, os, time

LIB_DIR = "/usr/share/linux-universe/books"
API = "https://ru.wikisource.org/w/api.php"
MAX_BYTES = 58 * 1024 * 1024
current_bytes = 0
count = 0
seen = set()

def api_get(params):
    params["format"] = "json"
    url = API + "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": "linux-universe-build/1.0"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read().decode("utf-8"))

def get_category_members(category, limit=500):
    members = []
    cont = {}
    while len(members) < limit:
        params = {
            "action": "query", "list": "categorymembers",
            "cmtitle": f"Категория:{category}", "cmlimit": "500",
            "cmnamespace": "0",
        }
        params.update(cont)
        data = api_get(params)
        batch = data.get("query", {}).get("categorymembers", [])
        members.extend(batch)
        if "continue" in data:
            cont = data["continue"]
        else:
            break
    return members[:limit]

categories = [
    "Проза", "Роман", "Фантастика", "Фэнтези", "Детектив",
    "Поэзия", "Рассказ", "Повесть",
]

for cat in categories:
    if current_bytes >= MAX_BYTES:
        break
    try:
        members = get_category_members(cat, limit=300)
        print(f"Category '{cat}': found {len(members)} pages")
    except Exception as e:
        print(f"Category '{cat}' failed: {e}")
        continue

    for m in members:
        if current_bytes >= MAX_BYTES:
            break
        title = m.get("title")
        if not title or title in seen:
            continue
        seen.add(title)
        try:
            data = api_get({
                "action": "query", "prop": "extracts",
                "explaintext": "1", "titles": title,
            })
            pages = data.get("query", {}).get("pages", {})
            text = ""
            for _, page in pages.items():
                text = page.get("extract", "")
            if not text or len(text) < 500:
                continue
            safe_name = "".join(c if c.isalnum() else "_" for c in title)[:80]
            out_path = os.path.join(LIB_DIR, f"{safe_name}.txt")
            with open(out_path, "w", encoding="utf-8") as f:
                f.write(f"{title}\n\n{text}")
            size = os.path.getsize(out_path)
            current_bytes += size
            count += 1
        except Exception as e:
            print(f"Text '{title}' failed: {e}")
            continue
        time.sleep(0.1)

print(f"Downloaded {count} texts from ru.wikisource.org, {current_bytes / (1024*1024):.1f} MB total")
PYEOF

echo "Book library setup complete"
