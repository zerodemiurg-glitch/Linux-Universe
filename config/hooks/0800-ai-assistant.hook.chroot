#!/bin/bash
set -e

echo "Setting up Linux-Universe AI Assistant (llama.cpp + Qwen3-8B)..."

mkdir -p /opt/linux-universe-ai
cd /opt/linux-universe-ai

# The "latest" release is a semantic-version release without binaries.
# Real prebuilt binaries live in the "nightly" release, tag looks like bNNNNN.
LATEST_JSON=$(curl -fsSL -H "User-Agent: linux-universe-build" https://api.github.com/repos/ggml-org/llama.cpp/releases/latest)
NIGHTLY_TAG=$(echo "$LATEST_JSON" | grep -oE '"Nightly build:\*\*[^0-9]*b[0-9]+' | grep -oE 'b[0-9]+' | head -1)

if [ -z "$NIGHTLY_TAG" ]; then
    echo "WARNING: could not extract nightly tag from latest release body, trying releases list"
    ALL_JSON=$(curl -fsSL -H "User-Agent: linux-universe-build" "https://api.github.com/repos/ggml-org/llama.cpp/releases?per_page=10")
    NIGHTLY_TAG=$(echo "$ALL_JSON" | grep -oE '"tag_name": ?"b[0-9]+"' | grep -oE 'b[0-9]+' | head -1)
fi

echo "Resolved nightly tag: $NIGHTLY_TAG"

if [ -n "$NIGHTLY_TAG" ]; then
    NIGHTLY_JSON=$(curl -fsSL -H "User-Agent: linux-universe-build" "https://api.github.com/repos/ggml-org/llama.cpp/releases/tags/${NIGHTLY_TAG}")
    echo "--- asset names in nightly release ---"
    echo "$NIGHTLY_JSON" | grep -oE '"name": ?"[^"]+"' | head -40
    LATEST_URL=$(echo "$NIGHTLY_JSON" | grep -oE '"browser_download_url": ?"[^"]*llama-b[0-9]+-bin-ubuntu-x64\.tar\.gz"' | cut -d'"' -f4 | head -1)
fi

if [ -n "$LATEST_URL" ]; then
    echo "Found llama.cpp asset: $LATEST_URL"
    curl -fL --retry 5 --retry-delay 5 --retry-connrefused "$LATEST_URL" -o llamacpp.tar.gz
    mkdir -p /opt/linux-universe-ai/bin
    tar -xzf llamacpp.tar.gz -C /opt/linux-universe-ai/bin
    rm llamacpp.tar.gz
    echo "llama.cpp binaries downloaded"
else
    echo "WARNING: still could not resolve llama.cpp binary asset URL"
fi

# Download quantized Qwen3-8B model (~5GB, Q4_K_M) from official Qwen repo
echo "Downloading Qwen3-8B model (this is large, please wait)..."
curl -fL --retry 5 --retry-delay 5 --retry-connrefused -o model.gguf \
    "https://huggingface.co/Qwen/Qwen3-8B-GGUF/resolve/main/Qwen3-8B-Q4_K_M.gguf"

if [ -s model.gguf ]; then
    echo "AI model downloaded successfully: $(du -h model.gguf | cut -f1)"
else
    echo "WARNING: model.gguf is missing or empty"
fi

echo "AI Assistant setup complete"
