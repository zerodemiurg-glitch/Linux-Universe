#!/bin/bash
set -e

echo "Building OSTree repository from system (excluding heavy blobs)..."

TMP_TREE=$(mktemp -d)
TMP_REPO=$(mktemp -d)
DEST_DIR="chroot/usr/share/linux-universe/ostree-repo"

echo "Copying filtered tree (excluding AI model and devbox images)..."
rsync -a chroot/ "$TMP_TREE/" \
    --exclude="usr/share/linux-universe/devbox-images/" \
    --exclude="opt/linux-universe-ai/model.gguf" \
    --exclude="usr/share/linux-universe/ostree-repo/"

ostree --repo="$TMP_REPO" init --mode=archive

ostree --repo="$TMP_REPO" commit \
    --branch=linux-universe/1.0/x86_64 \
    --subject="Linux-Universe 1.0 base commit" \
    --tree=dir="$TMP_TREE" \
    --skip-if-unchanged

echo "OSTree repository built (filtered tree):"
ostree --repo="$TMP_REPO" log linux-universe/1.0/x86_64 | head -10
du -sh "$TMP_REPO"

mkdir -p "$DEST_DIR"
cp -a "$TMP_REPO"/. "$DEST_DIR"/
rm -rf "$TMP_REPO" "$TMP_TREE"

echo "OSTree repository copied into image: $(du -sh "$DEST_DIR" | cut -f1)"
