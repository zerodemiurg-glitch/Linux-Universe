#!/bin/bash
set -e

echo "Dev-Box Workspace: building offline container images (host-side)..."

IMG_DIR="chroot/usr/share/linux-universe/devbox-images"
mkdir -p "$IMG_DIR"
WORKDIR=$(mktemp -d)

build_image() {
    local name="$1"
    local packages="$2"
    echo "Building image: $name"
    mkdir -p "$WORKDIR/$name"
    cat > "$WORKDIR/$name/Containerfile" << CFEOF
FROM debian:stable-slim
RUN apt-get update && apt-get install -y --no-install-recommends $packages && rm -rf /var/lib/apt/lists/*
CFEOF
    if podman build -t "local/dev-$name" "$WORKDIR/$name" 2>&1; then
        podman save -o "$IMG_DIR/$name.tar" "local/dev-$name"
        echo "Image $name saved: $(du -h "$IMG_DIR/$name.tar" | cut -f1)"
    else
        echo "WARNING: failed to build image for $name"
    fi
}

build_image "python" "python3 python3-pip python3-venv"
build_image "node"   "nodejs npm"
build_image "go"     "golang-go"
build_image "rust"   "rustc cargo"
build_image "java"   "default-jdk"
build_image "cpp"    "build-essential gdb"
build_image "ai-agent-sandbox" "python3 python3-pip build-essential gdb git curl nano"

rm -rf "$WORKDIR"

echo "Dev-Box offline images setup complete: $(ls -la "$IMG_DIR" | wc -l) files"
