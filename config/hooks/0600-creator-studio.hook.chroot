#!/bin/sh
set -e

echo "Setting up Creator Studio (Flatpak apps)..."

flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# Video editing
flatpak install -y --noninteractive flathub org.shotcut.Shotcut || echo "WARNING: Shotcut install failed"

# Audio editing
flatpak install -y --noninteractive flathub org.audacityteam.Audacity || echo "WARNING: Audacity install failed"

# Image editing
flatpak install -y --noninteractive flathub org.gimp.GIMP || echo "WARNING: GIMP install failed"

# Vector graphics
flatpak install -y --noninteractive flathub org.inkscape.Inkscape || echo "WARNING: Inkscape install failed"

# E-book reader (all formats: epub, fb2, txt, pdf via companion)
flatpak install -y --noninteractive flathub com.bilingify.readest || echo "WARNING: Readest install failed"

# Notes app
flatpak install -y --noninteractive flathub org.gnome.Notes || echo "WARNING: GNOME Notes install failed"

# Audiobook player
flatpak install -y --noninteractive flathub com.github.geigi.cozy || echo "WARNING: Cozy install failed"

echo "Creator Studio setup complete"
