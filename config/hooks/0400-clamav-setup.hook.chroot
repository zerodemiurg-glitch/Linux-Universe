#!/bin/sh
set -e

systemctl enable clamav-freshclam.service
systemctl enable clamav-daemon.service

echo "ClamAV services enabled (freshclam + daemon)"

ufw default deny incoming
ufw default allow outgoing
ufw --force enable
echo "UFW firewall enabled by default"

systemctl enable apparmor
aa-enforce /etc/apparmor.d/* 2>/dev/null || true
echo "AppArmor enabled with enforce mode on available profiles"

groupadd -f wireshark
usermod -aG wireshark $(getent passwd 1000 | cut -d: -f1) 2>/dev/null || true
chgrp wireshark /usr/bin/dumpcap 2>/dev/null || true
chmod 750 /usr/bin/dumpcap 2>/dev/null || true
setcap cap_net_raw,cap_net_admin+eip /usr/bin/dumpcap 2>/dev/null || true

pip3 install --break-system-packages recon-ng 2>&1 || echo "WARNING: recon-ng install failed"

systemctl disable tor 2>/dev/null || true
echo "Pentest core tools configured (Wireshark non-root, recon-ng, Tor ready but off by default)"

systemctl enable auditd
echo "-w /usr/local/bin/linux-universe-airgap -p x -k airgap_toggle" >> /etc/audit/rules.d/linux-universe.rules
echo "Auditd enabled, tracking Air-Gap toggle attempts"

if [ -f /etc/default/grub ]; then
    sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="/GRUB_CMDLINE_LINUX_DEFAULT="lockdown=integrity /' /etc/default/grub
fi
echo "Kernel lockdown mode (integrity) configured"

chattr +i /usr/local/bin/linux-universe-airgap 2>/dev/null || echo "NOTE: chattr +i not supported on this filesystem at build time"
echo "Air-Gap script protected with immutable flag"

for i in 1 2 3 4 5; do
    systemctl enable "linux-universe-watchdog@${i}.service"
done
echo "5-node mutual watchdog ring enabled"
